From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chris <08a487@gmail.com>
Date: Sun, 18 Oct 2026 08:40:23 -0600
Subject: [PATCH 21/21] arm64: dts: qcom: msm8994-huawei-angler: Add the
 notification LED

The RGB notification LED is on PMI8994's LPG: red, green and blue on
channels 3, 2 and 1, as the stock kernel's qcom,leds-qpnp node has them.
List red first, since the power supply's multicolor trigger gives its
intensities in red, green, blue order, and show the charge state on it
by default (orange while charging, green when full), as stock does.
---
 .../qcom/msm8994-huawei-angler-rev-101.dts    | 36 +++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8994-huawei-angler-rev-101.dts b/arch/arm64/boot/dts/qcom/msm8994-huawei-angler-rev-101.dts
index 90c8ed5f7..b870e5c11 100644
--- a/arch/arm64/boot/dts/qcom/msm8994-huawei-angler-rev-101.dts
+++ b/arch/arm64/boot/dts/qcom/msm8994-huawei-angler-rev-101.dts
@@ -9,6 +9,7 @@
 
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/leds/common.h>
 #include "msm8994.dtsi"
 #include "pm8994.dtsi"
 #include "pmi8994.dtsi"
@@ -431,6 +432,41 @@ &pmi8994_fg {
 	status = "okay";
 };
 
+/*
+ * The notification LED: red, green and blue on LPG channels 3, 2 and 1
+ * (stock). Listed red first: the power supply's multicolor trigger gives its
+ * intensities in red, green, blue order.
+ */
+&pmi8994_lpg {
+	qcom,power-source = <1>;
+
+	status = "okay";
+
+	multi-led {
+		color = <LED_COLOR_ID_RGB>;
+		function = LED_FUNCTION_STATUS;
+		linux,default-trigger = "qcom-battery-charging-orange-full-green";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		led@3 {
+			reg = <3>;
+			color = <LED_COLOR_ID_RED>;
+		};
+
+		led@2 {
+			reg = <2>;
+			color = <LED_COLOR_ID_GREEN>;
+		};
+
+		led@1 {
+			reg = <1>;
+			color = <LED_COLOR_ID_BLUE>;
+		};
+	};
+};
+
 &pmi8994_smbchg {
 	monitored-battery = <&battery>;
 	status = "okay";
