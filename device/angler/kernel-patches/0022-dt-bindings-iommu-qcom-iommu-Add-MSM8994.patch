From 1025023e5d5f917c8f3d1bffc4223ffea5f9640e Mon Sep 17 00:00:00 2001
From: chris <08a487@gmail.com>
Date: Sun, 18 Oct 2026 13:44:06 -0600
Subject: [PATCH 22/30] dt-bindings: iommu: qcom,iommu: Add MSM8994

The MSM8994 GPU sits behind an SMMU v1 whose global registers belong
to the secure world, like the MSM8916 one: Linux programs only the
context banks, after the secure configuration call. Add a compatible
for it.

Assisted-by: Claude Opus 5.5
---
 Documentation/devicetree/bindings/iommu/qcom,iommu.yaml | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Documentation/devicetree/bindings/iommu/qcom,iommu.yaml b/Documentation/devicetree/bindings/iommu/qcom,iommu.yaml
index 93a489025..703bb5cee 100644
--- a/Documentation/devicetree/bindings/iommu/qcom,iommu.yaml
+++ b/Documentation/devicetree/bindings/iommu/qcom,iommu.yaml
@@ -24,6 +24,7 @@ properties:
               - qcom,msm8917-iommu
               - qcom,msm8937-iommu
               - qcom,msm8953-iommu
+              - qcom,msm8994-iommu
           - const: qcom,msm-iommu-v1
       - items:
           - enum:
@@ -45,6 +46,12 @@ properties:
       - const: bus
       - const: tbu
 
+  memory-region:
+    maxItems: 1
+    description:
+      Reserved memory, not mapped by the OS, for the secure page tables the
+      secure world sets up when an instance has secure contexts.
+
   power-domains:
     maxItems: 1
 
-- 
