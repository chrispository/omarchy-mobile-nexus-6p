From 2567b41409ff17d3a84e32993394b19847f9c900 Mon Sep 17 00:00:00 2001
From: chris <08a487@gmail.com>
Date: Sun, 18 Oct 2026 02:53:11 -0600
Subject: [PATCH 02/13] arm64: dts: qcom: msm8994-huawei-angler: Add
 touchscreen

The Nexus 6P has a Synaptics RMI4 touch controller at 0x70 on BLSP1 QUP2,
with its interrupt on GPIO 77 (active low), reset on GPIO 96 (active low)
and an I2C bus switch on GPIO 38, powered from L22 (3.1 V) and L30 (1.85 V).
Values from the angler board DT in Google's GPL kernel
(android-msm-angler-3.10-oreo-mr1, huawei_msm8994_angler_vn2/huawei-tp.dtsi).
The downstream driver flips both axes.
---
 .../qcom/msm8994-huawei-angler-rev-101.dts    | 60 +++++++++++++++++++
 1 file changed, 60 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8994-huawei-angler-rev-101.dts b/arch/arm64/boot/dts/qcom/msm8994-huawei-angler-rev-101.dts
index bd777463f..2d75d9104 100644
--- a/arch/arm64/boot/dts/qcom/msm8994-huawei-angler-rev-101.dts
+++ b/arch/arm64/boot/dts/qcom/msm8994-huawei-angler-rev-101.dts
@@ -7,6 +7,8 @@
 
 /dts-v1/;
 
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
 #include "msm8994.dtsi"
 #include "pm8994.dtsi"
 
@@ -74,8 +76,66 @@ &blsp1_uart2 {
 	pinctrl-1 = <&blsp1_uart2_sleep>;
 };
 
+&blsp1_i2c2 {
+	/* BAM DMA doesn't probe on this board yet; PIO is plenty for touch */
+	/delete-property/ dmas;
+	/delete-property/ dma-names;
+	status = "okay";
+
+	touchscreen@70 {
+		compatible = "syna,rmi4-i2c";
+		reg = <0x70>;
+
+		interrupts-extended = <&tlmm 77 IRQ_TYPE_LEVEL_LOW>;
+		vdd-supply = <&pm8994_l22>;
+		vio-supply = <&pm8994_l30>;
+
+		pinctrl-0 = <&ts_int_default>;
+		pinctrl-names = "default";
+
+		syna,startup-delay-ms = <200>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		rmi4-f01@1 {
+			reg = <0x1>;
+			syna,nosleep-mode = <1>;
+		};
+
+		rmi4-f12@12 {
+			reg = <0x12>;
+			syna,sensor-type = <1>;
+			touchscreen-inverted-x;
+			touchscreen-inverted-y;
+		};
+	};
+};
+
 &tlmm {
 	gpio-reserved-ranges = <85 4>;
+
+	/* Touchscreen reset (active low) and its I2C bus switch: on */
+	ts-reset-hog {
+		gpio-hog;
+		gpios = <96 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "ts-reset-n";
+	};
+
+	ts-vbus-hog {
+		gpio-hog;
+		gpios = <38 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "ts-vbus";
+	};
+
+	ts_int_default: ts-int-default-state {
+		pins = "gpio77";
+		function = "gpio";
+		drive-strength = <6>;
+		bias-pull-up;
+	};
 };
 
 &rpm_requests {
