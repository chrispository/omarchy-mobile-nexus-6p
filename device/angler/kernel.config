# SPDX-License-Identifier: MIT
# Nexus 6P (angler, MSM8994) N1 fragment on top of arm64 defconfig.
# The N1 initramfs loads no modules: everything the first boot needs is =y.

# SoC basics the defconfig leaves out or builds as modules
CONFIG_PINCTRL_MSM8994=y
CONFIG_MSM_GCC_8994=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_USB_DWC3_QCOM=y

# USB gadget: CDC NCM network and ACM serial over configfs (the only link)
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y

# eMMC (N3): the initramfs guard sets every partition but userdata read-only
# as it appears, and refuses to switch root if it can't
CONFIG_MMC_SDHCI_MSM=y

# Display (nexus_linux_plan.md N2): simpledrm on the bootloader's splash
# buffer, a KMS device for Hyprland (software rendering) with fbcon on top,
# in a font readable at 1440x2560. The panel is command mode, so the
# initramfs's fbkick loop pushes the frames out.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=n
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# Multimedia clocks and GDSCs (GPU-PLAN G1): built in, so simpledrm, which
# holds the MDSS clocks and GDSC in the DTS, probes before the initramfs
CONFIG_MSM_MMCC_8994=y

# Touchscreen: Synaptics RMI4 over I2C (kernel branch omamobile-angler)
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F12=y

# PM8994 functions: power key (through qcom-pon), RTC (the clock survives a
# reboot), die temperature alarm and ADC
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_SPMI_VADC=y

# SMP without PSCI: power up the secondary cores into the spin table before
# SMP init (built in: it runs as an early initcall)
CONFIG_QCOM_MSM8994_CPU_BOOT=y

# Battery: PMI8994 charger (SMBCHG) and fuel gauge, from the msm8996 mainline
# tree (kernel branch omamobile-angler), as modules
CONFIG_EXTCON=y
CONFIG_CHARGER_QCOM_SMBCHG=m
CONFIG_BATTERY_QCOM_FG=m

# Firewall (Omarchy's ufw, through iptables-nft), as modules in the Arch root
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_COMPAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP6_NF_MATCH_RT=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_TARGET_LOG=m

# Unattended recovery: the APSS watchdog resets a hung kernel (the init pets
# it), and the reset boots the known-good image in the boot partition
CONFIG_QCOM_WDT=y
# The init sets nowayout through sysfs, so a hang late in shutdown, after the
# feeder exits, still resets
CONFIG_WATCHDOG_SYSFS=y
# Kernel messages over the USB network to the desktop, for hangs the journal
# can't see (late shutdown): GPU-PLAN.md
CONFIG_NETCONSOLE=m
CONFIG_NETCONSOLE_DYNAMIC=y

# Arch userspace: pacman 7 sandboxes its downloads with Landlock
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"

# Boot-time diagnostics. ramoops keeps the console of a crashed boot across
# the warm reset (build-n1 reserves it at 0x04000000)
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_MAGIC_SYSRQ=y
CONFIG_LOCALVERSION="-angler"
CONFIG_LOCALVERSION_AUTO=n

# Size: the stock bootloader puts the DTB at 0x01e00000 and the ramdisk at
# 0x02000000, so the unpacked kernel (with BSS) must end below 0x01e00000.
# arm64 defconfig is 41 MiB; build Qualcomm platform support only.
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_AIROHA=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_ARTPEC=n
CONFIG_ARCH_ASPEED=n
CONFIG_ARCH_AXIADO=n
CONFIG_ARCH_BCM2835=n
CONFIG_ARCH_BCM_IPROC=n
CONFIG_ARCH_BCMBCA=n
CONFIG_ARCH_BRCMSTB=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_BITMAIN=n
CONFIG_ARCH_BLAIZE=n
CONFIG_ARCH_BST=n
CONFIG_ARCH_CIX=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_LAN969X=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_MMP=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_S32=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_PENSANDO=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_SOPHGO=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_TESLA_FSD=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n

# Subsystems the N1 RAM-root boot doesn't use, off for size; they come back
# one at a time (N2 onwards), mostly as modules
CONFIG_VIRTUALIZATION=n
CONFIG_ACPI=n
CONFIG_XEN=n
CONFIG_PCI=n
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_CAN=n
CONFIG_NFS_FS=n
CONFIG_INFINIBAND=n
CONFIG_STAGING=n

# Vibrator: PMI8994 haptics (an LRA), from the msm8996 mainline tree
CONFIG_INPUT_QCOM_SPMI_HAPTICS=m
# CPU frequency: the cluster clocks for cpufreq-dt (device/angler/CPU-PLAN.md);
# a module, loaded by hand until the steps there pass
CONFIG_QCOM_CLK_CPU_8994=m
# Compressed swap in RAM (PERF-HANDOFF P1): 3 GB phone, no swap, reclaim
# stalls and major faults when launching apps
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
