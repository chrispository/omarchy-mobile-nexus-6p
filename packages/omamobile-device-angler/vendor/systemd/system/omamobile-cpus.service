[Unit]
Description=Bring up the secondary CPU cores (no PSCI on this firmware)
# Before the boot is marked good: a hang here leaves the initramfs dead-man
# to reset into the known-good image
Before=omamobile-boot-ok.service

[Service]
Type=oneshot
ExecStart=/usr/bin/omamobile-cpus
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
