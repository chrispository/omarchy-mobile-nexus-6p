#!/bin/bash
# SPDX-License-Identifier: MIT
# Bring up the Nexus 6P's other A53 cores (CPU1-3). The firmware has no
# PSCI: msm8994-cpu-boot powers them up into the spin table, then they are
# onlined here. The A57 cluster (CPU4-7) is not enabled yet: set
# OMAMOBILE_CPUS (a mask, 0x0e by default) in /etc/default/omamobile-cpus to
# try it.
set -euo pipefail
OMAMOBILE_CPUS=0x0e
[[ -r /etc/default/omamobile-cpus ]] && . /etc/default/omamobile-cpus
modprobe msm8994-cpu-boot cpus="$OMAMOBILE_CPUS"
for cpu in 1 2 3 4 5 6 7; do
  (( OMAMOBILE_CPUS & (1 << cpu) )) || continue
  f=/sys/devices/system/cpu/cpu$cpu/online
  [[ -e $f ]] || continue
  [[ $(cat "$f") == 1 ]] && continue
  timeout 20 sh -c "echo 1 > $f" || echo "CPU$cpu did not come online" >&2
done
echo "online: $(cat /sys/devices/system/cpu/online)"
